# Copy to deploy/.env and edit for `docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d`
AUDCTL_HOME=/home/jacobwalker
AUDCTL_UID=1000
AUDCTL_GID=1000
AUDCTL_SERVE_PORT=8765
AUDCTL_STATE_DIR=/home/jacobwalker/.local/state/audctl
AUDCTL_CONFIG_DIR=/home/jacobwalker/.config/audctl
# Chromium profile (must match paths inside container = same as host when bind-mounted).
AUDCTL_CHROMIUM_PROFILE_DIR=/home/jacobwalker/snap/chromium/common/axiom-audible-chrome
DISPLAY=:0
XAUTHORITY=/home/jacobwalker/.Xauthority
# Optional Bearer for audctl serve:
# AUDCTL_HTTP_TOKEN=
